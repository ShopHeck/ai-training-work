# ---------------------------------------------------------------------------
# Collection — Tavily search/extract API (https://tavily.com, free tier exists)
# ---------------------------------------------------------------------------
TAVILY_API_KEY=tvly-your-key-here

# Optional: also search Hacker News' free Algolia API (no key needed)
# HN_SEARCH_ENABLED=true

# ---------------------------------------------------------------------------
# Generation — pick ONE LLM provider: "anthropic" (default) or "openai"
# ---------------------------------------------------------------------------
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-your-key-here
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929
# OPENAI_API_KEY=sk-your-key-here
# OPENAI_MODEL=gpt-5-mini

# ---------------------------------------------------------------------------
# Publishing — everything is OFF by default. Drafts are only written to
# output/<date>/ unless BOTH `--publish` is passed AND the platform toggle
# below is "true".
# ---------------------------------------------------------------------------
ENABLE_X_POSTING=false
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=

# LinkedIn posting is scaffolded but disabled — it needs a LinkedIn developer
# app + OAuth (w_member_social). See README "Enabling publishing".
ENABLE_LINKEDIN_POSTING=false
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_AUTHOR_URN=

# Reddit posting is scaffolded but disabled — it needs a Reddit script app
# (client id/secret + username/password). WARNING: auto-posting affiliate
# links commonly violates subreddit self-promotion rules — post manually.
ENABLE_REDDIT_POSTING=false
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USERNAME=
REDDIT_PASSWORD=
REDDIT_SUBREDDIT=
